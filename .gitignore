# The upstream Zellij source checkout is kept locally for build/reference work.
# The public zellij_intranet repository contains only docs and packaging.
/zellij/

# Local operating-system and editor files.
.DS_Store
.vscode/

# Python bytecode generated by packaging tests.
__pycache__/
*.py[cod]

# Release archives are distributed through GitHub Releases, not Git history.
# Keep the matching .sha256 and .manifest.json evidence files tracked.
/dist/official/*.tar.gz
/dist/official/*.zip
